app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android generated/build files
android/.gradle/
android/build/
android/local.properties
android/gradle/wrapper/gradle-wrapper.jar
android/gradlew
android/gradlew.bat

# Gradle crash/error logs
android/hs_err_pid*.log
hs_err_pid*.log

# Android generated files
android/.gradle/
android/local.properties
android/hs_err_pid*.log

# Keep Android Gradle wrapper files
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradlew
!android/gradlew.bat

# Keep Android source files
!android/app/src/main/java/
!android/app/src/main/java/**
!android/app/src/main/kotlin/
!android/app/src/main/kotlin/**